{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Node Runner",
  "version": "0.1.0",
  "identifier": "dev.noderunner.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Node Runner",
        "width": 1080,
        "height": 760,
        "minWidth": 880,
        "minHeight": 560,
        "resizable": true,
        "visible": true,
        "decorations": true,
        "theme": "Dark",
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "shortDescription": "Continuous compute node orchestrator",
    "longDescription": "Orchestrates a self-migrating compute node and protects its credentials in a zero-knowledge local vault."
  }
}
